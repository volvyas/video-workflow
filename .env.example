# Copy to .env and adjust. Real environment variables override this file.
# Use a different file for an experiment:  shorts -e .env.experiment make "topic"
# Empty value (KEY=) means "use the default".

# =============================================================================
# Provider selection: change these to switch implementations (restart only)
# =============================================================================
LLM_PROVIDER=claude              # claude | ollama | openai_compat | mock | my.module:MyClass
IDEAS_LLM_PROVIDER=              # optional per-stage override, e.g. ollama for cheap brainstorming
SCRIPT_LLM_PROVIDER=
TTS_PROVIDER=f5                  # f5 (local GPU) | comfyui (runs on the ComfyUI machine) | mock
ALIGN_PROVIDER=faster_whisper    # faster_whisper | proportional
IMAGE_PROVIDER=comfyui           # comfyui | mock
MOTION_PROVIDER=comfyui_i2v      # kenburns (mode A) | comfyui_i2v (mode B) | mock
MOTION_FALLBACK=kenburns         # used when the primary fails, or for scenes excluded by MOTION_SCENES
MOTION_SCENES=all                # all | none | first:N | every:N  -> which scenes get the primary provider
UPLOADER=none                    # none | youtube

# =============================================================================
# Content
# =============================================================================
CONTENT_LANGUAGE=English
CHANNEL_BRIEF=A faceless YouTube Shorts channel with surprising, accurate, fast-paced facts for curious adults.
VIDEO_TARGET_SECONDS=40
STYLE_PROMPT=cinematic, highly detailed, dramatic lighting, volumetric light, 35mm photo, vertical composition
NEGATIVE_PROMPT=text, letters, watermark, logo, signature, blurry, lowres, deformed, extra fingers, bad anatomy

# =============================================================================
# Format
# =============================================================================
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
IMAGE_WIDTH=768                  # keyframe size; use the image model's native ~1 MP 9:16 size
IMAGE_HEIGHT=1344
MOTION_WIDTH=480                 # I2V render size (480x832 fast, 720x1280 slow on 16 GB)
MOTION_HEIGHT=832
MOTION_FPS=16                    # Wan 2.x native 16 fps
MAX_SLOWDOWN=1.25                # clip shorter than the scene: slow it down up to this, then hold the last frame

# =============================================================================
# Audio & captions
# =============================================================================
SCENE_GAP_MS=120
MUSIC_DIR=assets/music           # random track per video; empty folder = no music
MUSIC_VOLUME=0.12                # ducked under the voice automatically
CAPTIONS_ENABLED=true
CAPTION_FONT=Montserrat ExtraBold
CAPTION_FONTS_DIR=assets/fonts
CAPTION_FONT_SIZE=92
CAPTION_COLOR=#FFFFFF
CAPTION_HIGHLIGHT_COLOR=#FFE500
CAPTION_OUTLINE_COLOR=#000000
CAPTION_OUTLINE=6
CAPTION_MARGIN_BOTTOM=560        # px from bottom; keeps captions clear of the Shorts UI
CAPTION_WORDS_PER_GROUP=3
CAPTION_UPPERCASE=true

# =============================================================================
# Infrastructure
# =============================================================================
COMFY_URL=http://127.0.0.1:8188  # can be another machine on the LAN (start ComfyUI with --listen)
COMFY_TIMEOUT=1800
RUNS_DIR=runs
IDEAS_DIR=ideas
PROMPTS_DIR=                     # folder with your own versions of src/shorts/prompts/*.txt
FFMPEG_PATH=                     # default: system ffmpeg, else bundled imageio-ffmpeg
UNLOAD_BETWEEN_STAGES=true
SEED=                            # fixed base seed for reproducible runs
AUTO_UPLOAD=false

# =============================================================================
# Provider settings (each provider only reads its own prefix)
# =============================================================================

# --- LLM: claude ---
ANTHROPIC_API_KEY=               # or LLM_CLAUDE_API_KEY, or `ant auth login`
LLM_CLAUDE_MODEL=claude-opus-5-5 # e.g. claude-sonnet-5-5 / claude-haiku-5-5 for cheaper runs
LLM_CLAUDE_EFFORT=medium         # low | medium | high | xhigh | max | none
LLM_CLAUDE_MAX_TOKENS=16000
LLM_CLAUDE_FALLBACKS=auto        # auto | default | off  (server-side fallback if a request is declined)

# --- LLM: ollama ---
LLM_OLLAMA_URL=http://127.0.0.1:11434
LLM_OLLAMA_MODEL=qwen3:14b
LLM_OLLAMA_TEMPERATURE=0.8
LLM_OLLAMA_NUM_CTX=8192
LLM_OLLAMA_THINK=false

# --- LLM: openai_compat (LM Studio, llama.cpp server, vLLM) ---
LLM_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
LLM_OPENAI_MODEL=local-model
LLM_OPENAI_RESPONSE_FORMAT=json_schema   # json_schema | json_object | none

# --- TTS: f5 ---
TTS_F5_MODEL=F5TTS_v1_Base
TTS_F5_CKPT_FILE=                # finetuned checkpoint for other languages
TTS_F5_VOCAB_FILE=
TTS_F5_REF_AUDIO=assets/voices/narrator.wav
TTS_F5_REF_TEXT=                 # exact transcript of the reference clip (empty = auto-transcribe)
TTS_F5_SPEED=1.0
TTS_F5_NFE_STEP=32
TTS_F5_SEED=

# --- TTS: comfyui (voice model runs inside ComfyUI, e.g. ComfyUI-F5-TTS node) ---
TTS_COMFY_WORKFLOW=workflows/tts_f5_comfy.json
TTS_COMFY_REF_AUDIO=assets/voices/narrator.wav   # local file; uploaded to ComfyUI automatically
TTS_COMFY_REF_TEXT=              # exact transcript of the reference clip (required by the F5 workflow)
TTS_COMFY_SPEED=1.0
TTS_COMFY_SEED=1

# --- Align: faster_whisper ---
ALIGN_WHISPER_MODEL=large-v3-turbo
ALIGN_WHISPER_DEVICE=auto
ALIGN_WHISPER_COMPUTE_TYPE=default
ALIGN_WHISPER_LANGUAGE=en

# --- Image: comfyui ---
IMAGE_COMFY_WORKFLOW=workflows/image_flux_dev_fp8.json

# --- Motion: kenburns ---
MOTION_KENBURNS_ZOOM=1.18
MOTION_KENBURNS_EASING=ease_in_out
MOTION_KENBURNS_RESAMPLE=bicubic # bilinear is ~2x faster

# --- Motion: comfyui_i2v ---
MOTION_I2V_WORKFLOW=workflows/i2v_wan22.json
MOTION_I2V_MAX_FRAMES=81         # Wan: 81 frames = 5 s @ 16 fps
MOTION_I2V_FRAME_STEP=4          # Wan 4n+1, LTX 8n+1
MOTION_I2V_PROMPT_SUFFIX=

# --- Upload: youtube ---
UPLOAD_YOUTUBE_CLIENT_SECRETS=secrets/client_secret.json
UPLOAD_YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
UPLOAD_YOUTUBE_PRIVACY=private
UPLOAD_YOUTUBE_CATEGORY_ID=27
UPLOAD_YOUTUBE_DEFAULT_LANGUAGE=en
