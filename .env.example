# Copy to .env and adjust. Real environment variables override this file.
# Use a different file for an experiment:  shorts -e .env.experiment make "topic"
# Empty value (KEY=) means "use the default".

# =============================================================================
# Provider selection: change these to switch implementations (restart only)
# =============================================================================
LLM_PROVIDER=openai_compat       # openai_compat (llama.cpp / llama-swap / LM Studio) | ollama | claude | mock | my.module:MyClass
IDEAS_LLM_PROVIDER=              # optional per-stage override, e.g. ollama for cheap brainstorming
SCRIPT_LLM_PROVIDER=
REVIEW_LLM_PROVIDER=             # fact-check + critique
IMAGE_QA_LLM_PROVIDER=           # must be vision-capable (Qwen3.8-Flash-Next with its mmproj is)
SEARCH_PROVIDER=ddgs             # web search for the local fact-check: ddgs (no key) | searxng (self-hosted) | none
TTS_PROVIDER=f5                  # f5 (non-commercial weights!) | kokoro (Apache-2.0) | comfyui (runs on ComfyUI machine) | mock
ALIGN_PROVIDER=faster_whisper    # faster_whisper | proportional
IMAGE_PROVIDER=comfyui           # comfyui | mock
MOTION_PROVIDER=comfyui_i2v      # kenburns (mode A) | comfyui_i2v (mode B) | mock
MOTION_FALLBACK=kenburns         # used when the primary fails, or for scenes excluded by MOTION_SCENES
MOTION_SCENES=all                # all | none | first:N | every:N  -> which scenes get the primary provider
SIMILARITY_PROVIDER=llm          # repeat check against history: llm (asks the LLM) | embeddings (/v1/embeddings server) | lexical (word overlap, instant) | none
SIMILARITY_LLM_PROVIDER=         # optional: a different LLM for the repeat check
MUSIC_PROVIDER=comfyui           # background music: comfyui (generated per video, ACE-Step) | folder (random from MUSIC_DIR) | none
UPLOADER=none                    # none | youtube

# =============================================================================
# Content
# =============================================================================
CONTENT_LANGUAGE=English
CHANNEL_BRIEF=A faceless YouTube Shorts channel with surprising, accurate, fast-paced facts for curious adults.
VIDEO_TARGET_SECONDS=40
STYLE_PROFILE=cinematic              # styles/<name>.env: cinematic | comic | cartoon | animated3d (`shorts styles`). A profile sets
                                 # STYLE_PROMPT, NEGATIVE_PROMPT, STYLE_GUIDE, caption look and motion prompt suffix,
                                 # overriding the same keys in this file. Per command: shorts --style cartoon make ...
# STYLE_PROMPT=                  # without a profile (or to override it from the shell): the channel look
# NEGATIVE_PROMPT=

# =============================================================================
# Quality gates
# =============================================================================
REVIEW_ENABLED=true              # fact-check + editorial review between script and voice
REVIEW_WEB_SEARCH=true           # verify claims with web search (if the review LLM supports it)
REVIEW_MIN_SCORE=7               # 1-10; below this after all rounds -> REVIEW_ON_LOW_SCORE
REVIEW_MAX_ROUNDS=2
REVIEW_ON_LOW_SCORE=fail         # fail (stop run; `shorts accept` to override) | continue
REVIEW_SEARCH_QUERIES=6          # local fact-check: search queries per round
REVIEW_SEARCH_RESULTS=4          # results per query
REVIEW_FETCH_PAGES=3             # also read the full text of the top N pages
STORYBOARD_APPROVAL=true         # stop before AI motion until approved: shorts storyboard (web page) / shorts approve RUN
IMAGE_QA_ENABLED=true            # vision check of each keyframe, re-roll bad ones
IMAGE_QA_MIN_SCORE=6
IMAGE_QA_MAX_RETRIES=2           # extra attempts per scene; the best candidate is kept

# =============================================================================
# Format
# =============================================================================
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
IMAGE_WIDTH=768                  # keyframe size; use the image model's native ~1 MP 9:16 size
IMAGE_HEIGHT=1344
MOTION_WIDTH=720                 # I2V render size; LTX-2.3: 720x1280 (~80 s per 5 s clip); Wan 2.2: 480x832
MOTION_HEIGHT=1280
MOTION_FPS=25                    # LTX-2.3 native 25 fps (Wan 2.x: 16)
MAX_SLOWDOWN=1.25                # clip shorter than the scene: slow it down up to this, then hold the last frame

# =============================================================================
# Audio & captions
# =============================================================================
SCENE_GAP_MS=120
MUSIC_DIR=assets/music           # tracks for MUSIC_PROVIDER=folder (random per video)
MUSIC_VOLUME=0.12                # ducked under the voice automatically
SFX_DIR=assets/sfx               # whoosh/hit sounds played on scene cuts; empty folder = none
SFX_VOLUME=0.35
SFX_LEAD=0.12                    # seconds before the cut
CAPTIONS_ENABLED=true
CAPTION_FONT=Montserrat ExtraBold
CAPTION_FONTS_DIR=assets/fonts
CAPTION_FONT_SIZE=92
CAPTION_COLOR=#FFFFFF
CAPTION_HIGHLIGHT_COLOR=#FFE500
CAPTION_OUTLINE_COLOR=#000000
CAPTION_OUTLINE=6
CAPTION_MARGIN_BOTTOM=560        # px from bottom; keeps captions clear of the Shorts UI
CAPTION_WORDS_PER_GROUP=3
CAPTION_UPPERCASE=true

# =============================================================================
# Infrastructure
# =============================================================================
COMFY_URL=http://127.0.0.1:8188  # can be another machine on the LAN (start ComfyUI with --listen)
COMFY_TIMEOUT=1800
RUNS_DIR=runs
IDEAS_DIR=ideas
HISTORY_ENABLED=true             # history of produced scripts: shorts history list | mark | similar | sync
HISTORY_FILE=history/scripts.json
HISTORY_ON_SIMILAR=warn          # warn (note + continue) | fail (stop the run, before the script if the idea repeats)
HISTORY_PROMPT_LIMIT=40          # history entries shown to the ideas LLM (avoid repeats, learn from popular ones)
PROMPTS_DIR=                     # folder with your own versions of src/shorts/prompts/*.txt
FFMPEG_PATH=                     # default: system ffmpeg, else bundled imageio-ffmpeg
UNLOAD_BETWEEN_STAGES=true
SEED=                            # fixed base seed for reproducible runs
AUTO_UPLOAD=false

# =============================================================================
# Provider settings (each provider only reads its own prefix)
# =============================================================================

# --- LLM: openai_compat (default: local Qwen3.8-Flash-Next on the GPU box via llama.cpp) ---
LLM_OPENAI_BASE_URL=http://127.0.0.1:8080/v1   # GPU box address if the LLM runs there
LLM_OPENAI_MODEL=qwen3.8-27b            # llama-swap / LM Studio pick the model by this name
LLM_OPENAI_TEMPERATURE=0.7
LLM_OPENAI_MAX_TOKENS=16000
LLM_OPENAI_RESPONSE_FORMAT=json_schema         # json_schema | json_object | none
LLM_OPENAI_TIMEOUT=1800                        # local MoE with experts in RAM can be slow on long outputs
LLM_OPENAI_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}   # thinking off: ~9 tok/s makes it cost minutes per call; remove to turn on
LLM_OPENAI_UNLOAD_URL=                         # frees VRAM before ComfyUI stages; llama-swap: http://<ai-box-ip>:8080/api/models/unload (deploy/llama-swap.yaml)
LLM_OPENAI_UNLOAD_METHOD=POST                  # llama-swap uses POST

# --- Search (local fact-check) ---
SEARCH_DDGS_REGION=us-en
SEARCH_DDGS_BACKENDS=google,yahoo,duckduckgo,bing,brave
SEARCH_SEARXNG_URL=http://127.0.0.1:8888

# --- Similarity (repeat check against history) ---
SIMILARITY_LLM_THRESHOLD=0.7                   # LLM score/10: 10 same story, 4-6 same subject other fact
SIMILARITY_LLM_CANDIDATES=30                   # closest earlier entries sent per check
SIMILARITY_LEXICAL_THRESHOLD=0.35              # word-overlap cosine; misses paraphrases
SIMILARITY_EMBEDDINGS_BASE_URL=http://127.0.0.1:8081/v1   # e.g. llama-server --embeddings -m nomic-embed-text-v1.5.Q8_0.gguf --port 8081
SIMILARITY_EMBEDDINGS_MODEL=nomic-embed-text-v1.5
SIMILARITY_EMBEDDINGS_PREFIX="clustering: "   # nomic wants a task prefix; empty for most other models
SIMILARITY_EMBEDDINGS_THRESHOLD=0.80

# --- LLM: claude (optional, paid API, billed separately from Claude subscriptions) ---
ANTHROPIC_API_KEY=               # or LLM_CLAUDE_API_KEY, or `ant auth login`
LLM_CLAUDE_MODEL=claude-opus-5-5 # e.g. claude-sonnet-5-5 / claude-haiku-5-5 for cheaper runs
LLM_CLAUDE_EFFORT=medium         # low | medium | high | xhigh | max | none
LLM_CLAUDE_MAX_TOKENS=16000
LLM_CLAUDE_FALLBACKS=auto        # auto | default | off  (server-side fallback if a request is declined)
LLM_CLAUDE_WEB_SEARCH=true       # used by the fact-check (billed per search, see docs/SETUP.md)
LLM_CLAUDE_WEB_SEARCH_MAX_USES=8

# --- LLM: ollama ---
LLM_OLLAMA_URL=http://127.0.0.1:11434
LLM_OLLAMA_MODEL=qwen3:14b
LLM_OLLAMA_TEMPERATURE=0.8
LLM_OLLAMA_NUM_CTX=8192
LLM_OLLAMA_THINK=false
LLM_OLLAMA_VISION_MODEL=         # e.g. qwen2.5vl:7b for image QA; empty = use LLM_OLLAMA_MODEL

# --- TTS: kokoro (Apache-2.0, preset voices) ---
TTS_KOKORO_VOICE=am_michael      # af_heart, af_bella, am_fenrir, bm_george, ... ; blend: af_heart,am_michael
TTS_KOKORO_SPEED=1.05

# --- TTS: f5 (weights are CC-BY-NC: not for monetized use) ---
TTS_F5_MODEL=F5TTS_v1_Base
TTS_F5_CKPT_FILE=                # finetuned checkpoint for other languages
TTS_F5_VOCAB_FILE=
TTS_F5_REF_AUDIO=assets/voices/narrator.wav
TTS_F5_REF_TEXT=                 # exact transcript of the reference clip (empty = auto-transcribe)
TTS_F5_SPEED=1.0
TTS_F5_NFE_STEP=32
TTS_F5_SEED=

# --- TTS: comfyui (voice model runs inside ComfyUI, e.g. ComfyUI-F5-TTS node) ---
TTS_COMFY_WORKFLOW=workflows/tts_f5_comfy.json
TTS_COMFY_REF_AUDIO=assets/voices/narrator.wav   # local file; uploaded to ComfyUI automatically
TTS_COMFY_REF_TEXT=              # exact transcript of the reference clip (required by the F5 workflow)
TTS_COMFY_SPEED=1.0
TTS_COMFY_SEED=1

# --- Align: faster_whisper ---
ALIGN_WHISPER_MODEL=large-v3-turbo
ALIGN_WHISPER_DEVICE=auto
ALIGN_WHISPER_COMPUTE_TYPE=default
ALIGN_WHISPER_LANGUAGE=en

# --- Image: comfyui ---
IMAGE_COMFY_WORKFLOW=workflows/image_zimage_turbo.json   # or image_flux_dev_fp8.json / image_sdxl.json

# --- Motion: kenburns ---
MOTION_KENBURNS_ZOOM=1.18
MOTION_KENBURNS_EASING=ease_in_out
MOTION_KENBURNS_RESAMPLE=bicubic # bilinear is ~2x faster

# --- Motion: comfyui_i2v ---
MOTION_I2V_WORKFLOW=workflows/i2v_ltx23.json         # or i2v_wan22.json (then FPS 16, MAX_FRAMES 81, FRAME_STEP 4)
MOTION_I2V_MAX_FRAMES=153        # LTX: 153 frames = ~6 s @ 25 fps (Wan: 81 @ 16)
MOTION_I2V_FRAME_STEP=8          # LTX 8n+1, Wan 4n+1
MOTION_I2V_PROMPT_SUFFIX=

# --- Music: comfyui (ACE-Step 1.5 XL Turbo, MIT; ~25 s per track on the 5070 Ti) ---
MUSIC_COMFY_WORKFLOW=workflows/music_acestep15_turbo.json
MUSIC_COMFY_LYRICS=[Instrumental]
MUSIC_COMFY_TAGS_SUFFIX=instrumental, no vocals
MUSIC_COMFY_DEFAULT_TAGS=cinematic ambient, soft synth pads, light percussion, curious, documentary, instrumental

# --- Upload: youtube ---
UPLOAD_YOUTUBE_CLIENT_SECRETS=secrets/client_secret.json
UPLOAD_YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
UPLOAD_YOUTUBE_PRIVACY=private
UPLOAD_YOUTUBE_CATEGORY_ID=27
UPLOAD_YOUTUBE_DEFAULT_LANGUAGE=en
