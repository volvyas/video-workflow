{
  "1": {
    "class_type": "ChatterboxTTS",
    "_meta": {
      "title": "Chatterbox TTS"
    },
    "inputs": {
      "model_pack_name": "chatterbox",
      "text": "{{text}}",
      "max_new_tokens": 1000,
      "flow_cfg_scale": 0.7,
      "exaggeration": "{{exaggeration}}",
      "temperature": 0.8,
      "cfg_weight": "{{cfg_weight}}",
      "repetition_penalty": 1.2,
      "min_p": 0.05,
      "top_p": 1.0,
      "seed": "{{seed}}",
      "use_watermark": false,
      "device": "default",
      "dtype": "auto",
      "attention_mode": "sdpa",
      "top_k": 1000,
      "normalize_loudness": true,
      "num_steps": 10,
      "cfg_scale": 1.0,
      "enable_chunking": true,
      "max_chars_per_chunk": 400,
      "chunk_combination_method": "auto",
      "silence_between_chunks_ms": 100,
      "audio_prompt": [
        "3",
        0
      ]
    }
  },
  "2": {
    "class_type": "SaveAudio",
    "_meta": {
      "title": "Save Audio"
    },
    "inputs": {
      "audio": [
        "1",
        0
      ],
      "filename_prefix": "{{filename_prefix}}"
    }
  },
  "3": {
    "class_type": "LoadAudio",
    "_meta": {
      "title": "Voice sample to clone"
    },
    "inputs": {
      "audio": "{{ref_audio}}"
    }
  }
}