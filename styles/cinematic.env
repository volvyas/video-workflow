# Style profile: photographic, cinematic realism. Select with STYLE_PROFILE=cinematic or `shorts --style cinematic`.
# Any .env key may be set here; it overrides .env (but not real environment variables).
STYLE_PROMPT=cinematic, highly detailed, dramatic lighting, volumetric light, 35mm photo, vertical composition
NEGATIVE_PROMPT=text, letters, watermark, logo, signature, cartoon, illustration, 3d render, blurry, lowres, deformed, extra fingers, bad anatomy
STYLE_GUIDE=Photographic realism: real places, creatures and objects at plausible scale, natural or dramatic real-world lighting, every image has a detailed real environment.
MOTION_I2V_PROMPT_SUFFIX=cinematic camera motion, realistic physics
CAPTION_FONT=Montserrat ExtraBold
CAPTION_COLOR=#FFFFFF
CAPTION_HIGHLIGHT_COLOR=#FFE500
CAPTION_OUTLINE_COLOR=#000000
CAPTION_OUTLINE=6
